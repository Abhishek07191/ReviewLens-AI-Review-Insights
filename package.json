{
  "name": "reviewlens-ai-review-insights",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace server",
    "lint": "npm run lint --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
